# Copy to .env.prod on the Droplet and fill in real values.
#   cp .env.prod.example .env.prod
#
# This project is configured for IP access (no custom domain):
#   http://YOUR_DROPLET_IP/

# DigitalOcean Managed Postgres connection string (from the DO control panel).
# Include sslmode=require. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://doadmin:PASSWORD@HOST:25060/defaultdb?sslmode=require

# Must match how you open the site in the browser (http + Droplet IP).
CORS_ORIGINS=http://162.243.18.83

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# Seed sample data on first boot; set false after the first successful deploy if you prefer.
SEED_ON_STARTUP=true
