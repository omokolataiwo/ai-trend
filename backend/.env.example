# Local development against Homebrew Postgres + host Ollama
DATABASE_URL=postgresql+psycopg://aitrends:aitrends@127.0.0.1:5432/aitrends
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
SEED_ON_STARTUP=true

# DigitalOcean (example):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:25060/aitrends?sslmode=require
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# CORS_ORIGINS=https://your-frontend-domain
